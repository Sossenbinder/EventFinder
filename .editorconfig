root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,sln,slnx}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,md,css}]
indent_size = 2

# EF Core-generated migrations are regenerated by `dotnet ef migrations add`,
# not hand-edited; don't hold them to the same analyzer bar as our own code.
[**/Migrations/*.cs]
generated_code = true
